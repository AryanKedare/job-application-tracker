# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional public contact used by the login page "Request access" mailto link.
# Leave blank to hide the access-request link.
NEXT_PUBLIC_ACCESS_REQUEST_EMAIL=

# Server-only Supabase administration key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only application administrator credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Optional AI-assisted job import and automatic company icon resolution
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional maintenance mode
MAINTENANCE_MODE=false
