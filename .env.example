# -----------------------------------------------------------------------------
# Public browser configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional public contact used by the login-page Request access mailto flow.
# Leave blank to hide/disable the access-request option.
NEXT_PUBLIC_ACCESS_REQUEST_EMAIL=

# -----------------------------------------------------------------------------
# Server-only Supabase / admin configuration
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# -----------------------------------------------------------------------------
# Server-only Resend application email
# Used for admin update emails and emailed AI analysis PDFs.
# Supabase Auth SMTP (magic links/password recovery) is configured separately.
# No Resend Contacts or Segment configuration is required.
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=Job Tracker <updates@your-domain.example>
EMAIL_UNSUBSCRIBE_SECRET=replace-with-a-long-random-secret

# -----------------------------------------------------------------------------
# Server-only Vercel Cron authorization
# Required only if automatic month-end analysis emails are enabled in deployment.
# -----------------------------------------------------------------------------
CRON_SECRET=replace-with-a-long-random-secret

# -----------------------------------------------------------------------------
# Optional Groq AI
# Task-specific models can be changed independently without changing other AI work.
# -----------------------------------------------------------------------------
GROQ_API_KEY=

# General fallback
GROQ_MODEL=openai/gpt-oss-20b

# Add Job / job-description extraction
GROQ_IMPORT_MODEL=openai/gpt-oss-20b

# Low-cost company-name -> official-domain lookup
GROQ_LOGO_MODEL=llama-3.1-8b-instant

# Last-resort company-logo web search
GROQ_LOGO_WEB_MODEL=groq/compound-mini

# Manual + month-end application analysis
GROQ_ANALYSIS_MODEL=openai/gpt-oss-20b

# -----------------------------------------------------------------------------
# Optional maintenance mode
# -----------------------------------------------------------------------------
MAINTENANCE_MODE=false
